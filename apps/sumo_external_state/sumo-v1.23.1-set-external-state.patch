+                    return server.writeErrorStatusCmd(libsumo::CMD_SET_VEHICLE_VARIABLE,
+                                                      "The ninth parameter for setExternalState must be the matchThreshold given as a double.", outputStorage);
+                }
+                int strictLaneHint = 0;
+                if (numArgs == 10
+                        && !server.readTypeCheckingByte(inputStorage, strictLaneHint)) {
+                    return server.writeErrorStatusCmd(libsumo::CMD_SET_VEHICLE_VARIABLE,
+                                                      "The tenth parameter for setExternalState must be strictLaneHint given as a byte.", outputStorage);
+                }
+                libsumo::Vehicle::setExternalState(id, edgeID, laneIndex, x, y, angle, speed,
+                                                   acceleration, keepRouteFlag, matchThreshold, strictLaneHint != 0);
+            }
+            break;
