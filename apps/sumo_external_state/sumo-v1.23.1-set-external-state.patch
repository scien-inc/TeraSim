+void
+MSAbstractLaneChangeModel::resetForExternalState() {
+    // The external pose is authoritative. A continuous maneuver that was
+    // planned before assimilation must not switch the primary lane from stale
+    // completion state during the following simulationStep. Preserve posLat
+    // (unlike endLaneChangeManeuver) and rebuild only physical lane overlap.
+    cleanupShadowLane();
+    cleanupTargetLane();
+    myLaneChangeCompletion = 1;
+    myLaneChangeDirection = 0;
+    setManeuverDist(0.);
+    setSpeedLat(0.);
+    myAngleOffset = 0.;
+    myPreviousAngleOffset = 0.;
+    myAlreadyChanged = false;
+    clearGapsAtLCInit();
+    myNoPartiallyOccupatedByShadow.clear();
+    updateShadowLane();
+}
