diff --git a/src/microsim/MSVehicle.cpp b/src/microsim/MSVehicle.cpp
index 1792121ea..ef8353df9 100644
--- a/src/microsim/MSVehicle.cpp
+++ b/src/microsim/MSVehicle.cpp
@@ -382,0 +383 @@ MSVehicle::Influencer::Influencer() :
+    myRemotePositionGeometrySign(0.),
@@ -934,0 +936,64 @@ MSVehicle::Influencer::postProcessRemoteControl(MSVehicle* v) {
+void
+MSVehicle::Influencer::completeRemoteControl(MSVehicle* v, SUMOTime t) {
+    if (v->isOnRoad() && myRemoteLane != nullptr) {
+        // moveToXY reports the geometric lateral offset independently of the
+        // network drive side. First recover the geometry-side offset that
+        // reconstructs the external x/y state.
+        const double remotePosLat = v->getLateralPositionOnLane();
+        const double defaultGeometrySign = MSGlobals::gLefthand ? 1. : -1.;
+        const Position currentPos = myRemoteLane->geometryPositionAtOffset(
+                                        v->getPositionOnLane(), defaultGeometrySign * remotePosLat);
+        const Position flippedPos = myRemoteLane->geometryPositionAtOffset(
+                                        v->getPositionOnLane(), -defaultGeometrySign * remotePosLat);
+        double externalGeometrySign = defaultGeometrySign;
+        if (flippedPos != Position::INVALID
+                && (currentPos == Position::INVALID
+                    || flippedPos.distanceTo2D(myRemoteXYPos) < currentPos.distanceTo2D(myRemoteXYPos))) {
+            externalGeometrySign = -defaultGeometrySign;
+        }
+
+        // Lane indices normally follow the network drive side, but imported
+        // networks may contain the opposite geometric lane order. Determine
+        // the actual geometry direction of an index change from an adjacent
+        // lane so posLat remains meaningful to the lane-change model.
+        myRemotePositionGeometrySign = defaultGeometrySign;
+        const auto& edgeLanes = myRemoteLane->getEdge().getLanes();
+        const int laneIndex = myRemoteLane->getIndex();
+        const int neighborIndex = laneIndex + 1 < (int)edgeLanes.size()
+                                  ? laneIndex + 1
+                                  : laneIndex - 1;
+        if (neighborIndex >= 0 && neighborIndex < (int)edgeLanes.size()) {
+            const MSLane* neighborLane = edgeLanes[neighborIndex];
+            const double laneFraction = myRemoteLane->getLength() > 0.
+                                        ? v->getPositionOnLane() / myRemoteLane->getLength()
+                                        : 0.;
+            const double neighborPos = MIN2(neighborLane->getLength(),
+                                            MAX2(0., laneFraction * neighborLane->getLength()));
+            const Position neighborCenter = neighborLane->geometryPositionAtOffset(neighborPos);
+            const Position positiveProbe = myRemoteLane->geometryPositionAtOffset(
+                                               v->getPositionOnLane(), 0.5);
+            const Position negativeProbe = myRemoteLane->geometryPositionAtOffset(
+                                               v->getPositionOnLane(), -0.5);
+            if (neighborCenter != Position::INVALID
+                    && positiveProbe != Position::INVALID
+                    && negativeProbe != Position::INVALID) {
+                const double neighborDirection = neighborIndex > laneIndex ? 1. : -1.;
+                const double geometryDirection =
+                    positiveProbe.distanceTo2D(neighborCenter)
+                    < negativeProbe.distanceTo2D(neighborCenter) ? 1. : -1.;
+                myRemotePositionGeometrySign = geometryDirection * neighborDirection;
+            }
+        }
+        v->setLateralPositionOnLane(
+            externalGeometrySign * remotePosLat / myRemotePositionGeometrySign);
+        v->getLaneChangeModel().resetForExternalState();
+    }
+    if (myLastRemoteAccess == t) {
+        // Keep wasRemoteControlled() true while ensuring that planning in a
+        // simulationStep at the same timestamp no longer treats the vehicle
+        // as being controlled by a pending moveToXY command.
+        myLastRemoteAccess = t - 1;
+    }
+}
