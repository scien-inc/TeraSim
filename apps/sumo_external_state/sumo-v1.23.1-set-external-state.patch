+Helper::applyRemoteControl(MSVehicle* v) {
+    const auto controlled = myRemoteControlledVehicles.find(v->getID());
+    if (controlled == myRemoteControlledVehicles.end()) {
+        throw TraCIException("Vehicle '" + v->getID() + "' has no pending remote-control state.");
+    }
