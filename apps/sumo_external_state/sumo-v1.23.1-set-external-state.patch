+void
+Vehicle::setExternalState(const std::string& vehID, const std::string& edgeID, const int laneIndex,
+                          const double x, const double y, double angle, double speed, double acceleration,
+                          const int keepRoute, double matchThreshold) {
+    if (speed < 0) {
+        throw TraCIException("External speed must not be negative.");
+    }
+    MSBaseVehicle* vehicle = Helper::getVehicle(vehID);
+    MSVehicle* veh = dynamic_cast<MSVehicle*>(vehicle);
+    if (veh == nullptr) {
+        WRITE_WARNING("setExternalState not yet implemented for meso");
+        return;
+    }
+    moveToXY(vehID, edgeID, laneIndex, x, y, angle, keepRoute, matchThreshold);
+    Helper::applyRemoteControl(veh);
+    setSpeed(vehID, -1);
+    setPreviousSpeed(vehID, speed, acceleration);
+}
