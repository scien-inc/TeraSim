diff --git a/src/libsumo/Vehicle.cpp b/src/libsumo/Vehicle.cpp
index 239ef17be..947b205ac 100644
--- a/src/libsumo/Vehicle.cpp
+++ b/src/libsumo/Vehicle.cpp
@@ -21,0 +22 @@
+#include <cmath>
@@ -1837,0 +1839,104 @@ Vehicle::moveToXY(const std::string& vehID, const std::string& edgeID, const int
+void
+Vehicle::moveToXYImmediate(const std::string& vehID, const std::string& edgeID, const int laneIndex,
+                           const double x, const double y, double angle,
+                          const int keepRoute, double matchThreshold, bool strictLaneHint) {
+    if (strictLaneHint
+            && (!std::isfinite(x)
+                || !std::isfinite(y)
+                || !std::isfinite(angle)
+                || !std::isfinite(matchThreshold))) {
+        throw TraCIException("Strict immediate moveToXY requires finite x, y, angle and match threshold.");
+    }
+
+    MSBaseVehicle* vehicle = Helper::getVehicle(vehID);
+    MSVehicle* veh = dynamic_cast<MSVehicle*>(vehicle);
+    if (veh == nullptr) {
+        WRITE_WARNING("moveToXYImmediate not yet implemented for meso");
+        return;
+    }
+    if (!strictLaneHint) {
+        moveToXY(vehID, edgeID, laneIndex, x, y, angle, keepRoute, matchThreshold);
+    } else {
+        MSEdge* hintEdge = MSEdge::dictionary(edgeID);
+        if (hintEdge == nullptr) {
+            throw TraCIException("Unknown strict immediate moveToXY edge '" + edgeID + "'.");
+        }
+        const std::vector<MSLane*>& lanes = hintEdge->getLanes();
+        if (laneIndex < 0 || laneIndex >= (int)lanes.size()) {
+            throw TraCIException("Invalid strict immediate moveToXY lane index " + toString(laneIndex)
+                                 + " for edge '" + edgeID + "'.");
+        }
+        MSLane* hintLane = lanes[laneIndex];
+        if (!veh->isOnRoad() || veh->getLane() != hintLane) {
+            throw TraCIException("Strict immediate moveToXY lane '" + hintLane->getID()
+                                 + "' does not match vehicle '" + vehID
+                                 + "' current route lane '" + Named::getIDSecure(veh->getLane()) + "'.");
+        }
+        if (matchThreshold < 0.) {
+            throw TraCIException("Strict immediate moveToXY match threshold must not be negative.");
+        }
+
+        Position pos(x, y);
+        pos.setz(veh->getPosition().z());
+        const double geometryPos2D = hintLane->getShape().nearest_offset_to_point2D(pos, false);
+        const double geometryPos25D = hintLane->getShape().nearest_offset_to_point25D(pos, false);
+        const double bestDistance = hintLane->getShape().distance2D(pos, false);
+        const Position extendedCoordinates =
+            hintLane->getShape().transformToVectorCoordinates(pos, true);
+        const double shapeLength = hintLane->getShape().length2D();
+        if (geometryPos2D == GeomHelper::INVALID_OFFSET
+                || geometryPos25D == GeomHelper::INVALID_OFFSET
+                || bestDistance == GeomHelper::INVALID_OFFSET
+                || extendedCoordinates == Position::INVALID
+                || !std::isfinite(extendedCoordinates.x())
+                || !std::isfinite(extendedCoordinates.y())
+                || !std::isfinite(shapeLength)
+                || bestDistance > matchThreshold) {
+            throw TraCIException("Could not strictly apply immediate moveToXY for vehicle '" + vehID
+                                 + "' to lane '" + hintLane->getID()
+                                 + "' within threshold " + toString(matchThreshold) + ".");
+        }
+        // Lane geometry length includes elevation. Use the same 2.5D offset
+        // as moveToXY so a sloped shape endpoint maps to the declared lane end.
+        const double lanePos = hintLane->interpolateGeometryPosToLanePos(geometryPos25D);
+        double lanePosLat = bestDistance;
+        const bool projectsToStart = geometryPos2D <= POSITION_EPS;
+        const bool projectsToEnd = geometryPos2D >= shapeLength - POSITION_EPS;
+        const bool outsideLongitudinalRange =
+            (projectsToStart && extendedCoordinates.x() < -NUMERICAL_EPS)
+            || (projectsToEnd && extendedCoordinates.x() > shapeLength + NUMERICAL_EPS);
+        if (outsideLongitudinalRange) {
+            // nearest_offset_to_point2D clamps to a finite shape endpoint.
+            // Keep endpoint overrun longitudinal instead of rotating it into posLat.
+            lanePosLat = -extendedCoordinates.y();
+        } else {
+            PositionVector leftShape = hintLane->getShape();
+            try {
+                leftShape.move2side(-lanePosLat);
+            } catch (ProcessError&) {
+                throw TraCIException("Could not determine strict immediate moveToXY lateral position on lane '"
+                                     + hintLane->getID() + "'.");
+            }
+            if (leftShape.distance2D(pos) > bestDistance) {
+                lanePosLat = -lanePosLat;
+            }
+        }
+        if (angle != INVALID_DOUBLE_VALUE) {
+            while (angle >= 360.) {
+                angle -= 360.;
+            }
+            while (angle < 0.) {
+                angle += 360.;
+            }
+        } else {
+            angle = GeomHelper::naviDegree(
+                        hintLane->getShape().rotationAtOffset(geometryPos2D));
+        }
+        Helper::setRemoteControlled(
+            veh, pos, hintLane, lanePos, lanePosLat, angle,
+            veh->getRoutePosition(), ConstMSEdgeVector(),
+            MSNet::getInstance()->getCurrentTimeStep(), true);
+    }
+    Helper::applyRemoteControl(veh);
+}
+
